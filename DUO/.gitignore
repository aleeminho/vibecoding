# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment — never commit real credentials.
#
# Vite loads .env.local and .env.<mode>.local. The publishable key is designed
# to be public and ends up in the bundle anyway, but there is no reason for it
# to sit in git history, and the DeepSeek API key must never be here at all.
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.temp
supabase/.branches

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
