# Repository-root ignore rules.
#
# Each project keeps its own .gitignore for anything specific to it; this file
# only covers the things that would otherwise leak from ANY project in here.
# Git applies every .gitignore from the root down, so both are in force.

# Dependencies
node_modules/
vendor/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Secrets. The pattern is deliberately broad and the negation narrow: an
# unlisted env file is ignored by default, so forgetting to update this file
# fails safe rather than publishing a key.
.env
.env.*
!.env.example
*.pem
*.key

# The private half of the backup (machine memory, loose files, credentials) is
# checked out at private/ as its own repo. It is never part of this one, so any
# stray `git add .` here must not pick it up.
private/

# Loose root files kept for local use only (scratch, machine logs and one-off
# scripts). They were deliberately pulled from this repo's tree and live in the
# private backup; they must never be tracked here again.
/extract_bupot.py
/main.py
/test.CSV
/test - Copy.CSV

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Supabase CLI local state. The CLI writes this wherever it is run from, so a
# stray copy appears at the root whenever a command is issued from here rather
# than from DUO/. It is machine-local and meaningless to anyone else.
supabase/.temp/
